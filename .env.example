# ─── Obligatoire ───────────────────────────────────────────────
# Connexion PostgreSQL (fournie par ton hébergeur de base de données)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/masterclass
# Mets true si ton hébergeur PostgreSQL exige une connexion chiffrée (SSL)
DATABASE_SSL=false

# ─── Groupe WhatsApp (à renseigner dès que le groupe existe) ───
# Lien d'invitation réel : WhatsApp > ton groupe > Infos du groupe > Inviter via un lien
# Format attendu : https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_GROUP_INVITE_URL=
# Numéro de contact (chiffres uniquement, indicatif inclus) : +224 660 35 47 94
CONTACT_WHATSAPP_NUMBER=224660354794

# ─── Site ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Adresse définitive du site, sans « / » final (active l'URL canonique)
SITE_URL=
# Début de la masterclass, en UTC. Conakry = UTC+0 : 20 h 30 → 20:30:00Z
EVENT_START_ISO=2026-12-05T20:30:00Z
# Applique automatiquement les migrations SQL au démarrage
AUTO_MIGRATE=true
# Nombre max d'inscriptions par IP et par 15 min (large : réseaux mobiles partagés)
RATE_LIMIT_REGISTER_MAX=30

# ─── E-mail de confirmation (OPTIONNEL) ────────────────────────
# Laisse vide pour désactiver : le site n'annoncera alors aucun e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DIABY Salim <contact@ton-domaine.com>"
